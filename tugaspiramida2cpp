#include <iostream>
using namespace std;

int main() {
    int tinggi = 5;
    int i = 1;

    do {
        for (int j = 0; j < tinggi - i; j++) {
            cout << " ";
        }
        for (int k = 0; k < i; k++) {
            cout << "*";
        }
        cout << endl;
        i++;
    } while (i <= tinggi);

    return 0;
}
